<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APEX-CORE-X // IPPC Architecture Hub</title>
    <style>
        :root {
            --bg-color: #0d0f12;
            --panel-bg: #14181f;
            --accent-blue: #00f0ff;
            --accent-purple: #a124ff;
            --accent-red: #ff0055;
            --accent-green: #00ff88;
            --text-main: #e2e8f0;
            --text-dim: #718096;
            --border-color: #232936;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Monaco, monospace;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        header {
            background-color: var(--panel-bg);
            border-bottom: 2px solid var(--border-color);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-area h1 {
            margin: 0;
            font-size: 22px;
            letter-spacing: 2px;
            color: var(--accent-blue);
        }

        .logo-area span {
            font-size: 11px;
            color: var(--text-dim);
            text-transform: uppercase;
        }

        .status-badge {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid var(--accent-green);
            color: var(--accent-green);
            padding: 6px 14px;
            font-size: 12px;
            font-weight: bold;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .container {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @media (max-width: 900px) {
            .container { grid-template-columns: 1fr; }
        }

        .panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .panel h2 {
            margin-top: 0;
            font-size: 18px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
            color: var(--accent-blue);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Simulator Styles */
        .console-box {
            background-color: #07080a;
            border: 1px solid #1c2330;
            border-radius: 6px;
            height: 320px;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            overflow-y: auto;
            color: #a0aec0;
            line-height: 1.6;
        }

        .btn-group {
            margin-top: 20px;
            display: flex;
            gap: 15px;
        }

        .sim-btn {
            background: linear-gradient(135deg, #00b4d8, #00f0ff);
            color: #000;
            border: none;
            padding: 12px 24px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 12px;
            transition: all 0.2s ease;
        }

        .sim-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .sim-btn.danger {
            background: linear-gradient(135deg, #d90429, var(--accent-red));
            color: #fff;
        }

        .sim-btn.danger:hover {
            box-shadow: 0 0 15px rgba(255, 0, 85, 0.4);
        }

        /* Pipeline Flow Styles */
        .pipeline-flow {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 20px;
        }

        .layer-card {
            background: #1a202c;
            border-left: 4px solid var(--text-dim);
            padding: 12px 18px;
            border-radius: 0 4px 4px 0;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .layer-card.active-pass {
            border-left-color: var(--accent-green);
            background: rgba(0, 255, 136, 0.05);
        }

        .layer-card.active-fail {
            border-left-color: var(--accent-red);
            background: rgba(255, 0, 85, 0.05);
        }

        .layer-title {
            font-weight: bold;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        /* Tech Specs Grid */
        .specs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .spec-item {
            background: #171e29;
            padding: 15px;
            border-radius: 6px;
            border: 1px solid #242f42;
        }

        .spec-label {
            font-size: 11px;
            color: var(--text-dim);
            text-transform: uppercase;
        }

        .spec-value {
            font-size: 16px;
            font-weight: bold;
            color: #fff;
            margin-top: 5px;
        }

        .log-entry { margin-bottom: 4px; }
        .log-success { color: var(--accent-green); }
        .log-alert { color: var(--accent-red); font-weight: bold; }
        .log-info { color: var(--accent-blue); }
        .log-purple { color: var(--accent-purple); }
    </style>
</head>
<body>

    <header>
        <div class="logo-area">
            <h1>APEX-CORE-X // IPPC HUB</h1>
            <span>Infinimata Phase Photonic Chip Core Repository</span>
        </div>
        <div class="status-badge">System Token: Active</div>
    </header>

    <div class="container">
        
        <div class="panel">
            <h2>System Architectural Specifications</h2>
            <p style="font-size: 14px; color: var(--a0aec0); line-height: 1.6;">
                The IPPC platform moves computational security directly to the physical hardware routing matrix. By transforming electronic signals into modulated light paths, data validation occurs deterministically at the physical boundary layer without loading payload memory states into system registers.
            </p>
            
            <div class="specs-grid">
                <div class="spec-item">
                    <div class="spec-label">Core Control Unit</div>
                    <div class="spec-value" style="color: var(--accent-purple);">Lex AI (Hardware-Native)</div>
                </div>
                <div class="spec-item">
                    <div class="spec-label">Active Filtering Window</div>
                    <div class="spec-value">10 MHz (100ns / Evaluation)</div>
                </div>
                <div class="spec-item">
                    <div class="spec-label">Primary Authentication</div>
                    <div class="spec-value">2-Time Cryptographic Lock</div>
                </div>
                <div class="spec-item">
                    <div class="spec-label">Biometric Verification</div>
                    <div class="spec-value">Bio-Photonic Resonance Sync</div>
                </div>
                <div class="spec-item">
                    <div class="spec-label">Boundary Isolation</div>
                    <div class="spec-value">Null Snatch Protocol</div>
                </div>
                <div class="spec-item">
                    <div class="spec-label">Propagation Latency</div>
                    <div class="spec-value" style="color: var(--accent-green);">Near-Zero (Optical)</div>
                </div>
            </div>

            <h3 style="font-size: 14px; text-transform: uppercase; margin-top:30px; margin-bottom:10px; color: var(--accent-blue);">7-Layer Ingress Matrix Pipeline</h3>
            <div class="pipeline-flow">
                <div class="layer-card" id="layer-null">
                    <div class="layer-title">Layer 1: Null Zone (`NULL_ZONE`)</div>
                    <div class="layer-desc" style="font-size: 12px; color: var(--text-dim);">Initial hardware landing zone at boundary layer. Zero permission allocation.</div>
                </div>
                <div class="layer-card" id="layer-buffer">
                    <div class="layer-title">Layer 2: Buffer Matrix (`BUFFER`)</div>
                    <div class="layer-desc" style="font-size: 12px; color: var(--text-dim);">Optical delay infrastructure. Stabilizes wave propagation and phase timing alignment.</div>
                </div>
                <div class="layer-card" id="layer-firewall">
                    <div class="layer-title">Layer 3: Dynamic Firewall (`FIREWALL`)</div>
                    <div class="layer-desc" style="font-size: 12px; color: var(--text-dim);">10 MHz assessment gate managed by Lex AI to monitor signature metrics.</div>
                </div>
                <div class="layer-card" id="layer-cyto">
                    <div class="layer-title">Layer 4: Cytoplasm Security Gateway (`CYTO`)</div>
                    <div class="layer-desc" style="font-size: 12px; color: var(--text-dim);">Physical routing reconfiguration via dynamic spatial switching paths.</div>
                </div>
                <div class="layer-card" id="layer-output">
                    <div class="layer-title">Layer 5/6/7: Execution States (`LIGHT` / `GREY` / `PSEUDO`)</div>
                    <div class="layer-desc" style="font-size: 12px; color: var(--text-dim);">Core execution processing, sandboxed isolation telemetry, or honeypot mirage.</div>
                </div>
            </div>
        </div>

        <div class="panel" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <h2>Interactive Operational Telemetry</h2>
                <p style="font-size: 14px; color: var(--a0aec0); margin-bottom: 20px;">
                    Execute live architectural routing simulations below to observe how the multi-layered ecosystem and the Lex AI core interact to securely process or intercept incoming datasets.
                </p>
                <div class="console-box" id="console">
                    <div class="log-entry">[SYSTEM] APEX-CORE-X Engineering Terminal Online.</div>
                    <div class="log-entry">[SYSTEM] IPPC-v1.04 Hardware Interface: Standby.</div>
                    <div class="log-entry">[SYSTEM] Ready for operational telemetry tracking commands...</div>
                </div>
            </div>
            
            <div class="btn-group">
                <button class="sim-btn" onclick="runSimulation(false)">Verify Nominal Packet</button>
                <button class="sim-btn danger" onclick="runSimulation(true)">Simulate Malicious Exploit</button>
            </div>
        </div>

    </div>

    <script>
        const consoleEl = document.getElementById('console');
        let simRunning = false;

        function clearPipelineStyles() {
            document.querySelectorAll('.layer-card').forEach(el => {
                el.classList.remove('active-pass', 'active-fail');
            });
        }

        function appendLog(text, type = '') {
            const entry = document.createElement('div');
            entry.className = `log-entry ${type}`;
            entry.innerText = text;
            consoleEl.appendChild(entry);
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        function runSimulation(isAttack) {
            if (simRunning) return;
            simRunning = true;
            clearPipelineStyles();
            consoleEl.innerHTML = '';
            
            appendLog('[INIT] Initializing hardware operational tracking...', 'log-info');
            
            setTimeout(() => {
                appendLog('[AUTH] Initializing Bio-Photonic Sync verify loop...', 'log-info');
            }, 400);

            setTimeout(() => {
                appendLog('[AUTH] Bio-Photonic Sync: Resonance Matched.', 'log-success');
                appendLog('[AUTH] Checking hardware-accelerated 2-Time Password Lock...', 'log-info');
            }, 900);

            setTimeout(() => {
                appendLog('[AUTH] 2-Time Cryptographic Lock Validation: PASSED.', 'log-success');
                appendLog('[INGRESS] Data packet detected crossing physical intake threshold.', 'log-info');
                document.getElementById('layer-null').classList.add('active-pass');
            }, 1500);

            setTimeout(() => {
                appendLog('[LAYER 1] Dropping payload stream into [NULL_ZONE] containment perimeter.', 'log-purple');
                document.getElementById('layer-buffer').classList.add('active-pass');
            }, 2100);

            setTimeout(() => {
                appendLog('[LAYER 2] Activating micro-photonic delay matrix. [BUFFER] stabilized.', 'log-purple');
                appendLog('[LAYER 3] Route entering 10 MHz Phase Firewall grid configuration.', 'log-info');
                document.getElementById('layer-firewall').classList.add(isAttack ? 'active-fail' : 'active-pass');
            }, 2800);

            setTimeout(() => {
                appendLog('[ENGINE] Lex AI executing predictive signature evaluation...', 'log-purple');
            }, 3300);

            if (!isAttack) {
                setTimeout(() => {
                    appendLog('[LAYER 3] Firewall Evaluation: Signature Validated.', 'log-success');
                    appendLog('[LAYER 5] Conversion to optimized [LIGHT] carrier state active.', 'log-success');
                    document.getElementById('layer-output').classList.add('active-pass');
                    appendLog('[CORE] Packet routed to main processor registers at full speed. Routine Complete.', 'log-success');
                    simRunning = false;
                }, 4000);
            } else {
                setTimeout(() => {
                    appendLog('[ALERT] PHASE DEVIATION DETECTED BY LEX AI AT GATE_04.', 'log-alert');
                    appendLog('[ALERT] Exploit payload signature configuration identified.', 'log-alert');
                    document.getElementById('layer-cyto').classList.add('active-fail');
                }, 4000);

                setTimeout(() => {
                    appendLog('[INTERCEPT] Initiating [NULL SNATCH] Protocol counter-measures...', 'log-alert');
                    appendLog('[LAYER 4] Injecting localized control voltage to cytoplasm security gateway.', 'log-info');
                }, 4700);

                setTimeout(() => {
                    appendLog('[LAYER 4] [CYTO] Waveguide layout geometry successfully dilated.', 'log-alert');
                    appendLog('[LAYER 6] Threat forcefully snatched and isolated into [GREY_ZONE] sandbox.', 'log-purple');
                    document.getElementById('layer-output').classList.add('active-fail');
                }, 5400);

                setTimeout(() => {
                    appendLog('[LAYER 7] [PSEUDO] system activated. Feeding threat fake hardware telemetry loops.', 'log-purple');
                    appendLog('[SYSTEM] Processing matrix unhindered. Threat Neutralized.', 'log-success');
                    simRunning = false;
                }, 6100);
            }
        }
    </script>
</body>
</html>
